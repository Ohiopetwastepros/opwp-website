{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opwp-website",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ohiopetwastepros.com",
      "zone_name": "ohiopetwastepros.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ohiopetwastepros.com",
      "zone_name": "ohiopetwastepros.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opwp-backend",
      "database_id": "507e3ffd-5249-4ff1-a72f-463e37dc068e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FIELD_PROOFS",
      "bucket_name": "opwp-field-proofs"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "FOOD_SALES_NATIVE_ENABLED": "true",
    "FOOD_SALES_RECORDING_ENABLED": "true",
    "FOOD_SALES_LEGACY_WRITES_FROZEN": "false",
    "FOOD_SALES_SNG_RECONCILIATION_ENABLED": "false",
    "DISPATCH_AUTOMATION_ENABLED": "false",
    "ROUTE_ROAD_CALCULATIONS_ENABLED": "false",
    "SITE_ORIGIN": "https://www.ohiopetwastepros.com",
    "WORKER_ORIGIN": "https://www.ohiopetwastepros.com",
    "TURNSTILE_HOSTNAMES": "ohiopetwastepros.com,www.ohiopetwastepros.com",
    "OWNER_NOTIFICATION_EMAIL": "Craig@ohiopetwastepros.com",
    "EMAIL_FROM": "Craig@ohiopetwastepros.com",
    "EMAIL_FROM_NAME": "Craig | Ohio Pet Waste Pros",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_SENDING_ENABLED": "true",
    "RESEND_API_BASE_URL": "https://api.resend.com",
    "SMS_PROVIDER": "quo",
    "FIELD_NOTIFICATIONS_ENABLED": "false",
    "FIELD_SMS_DAILY_LIMIT": "100",
    "QUO_API_BASE_URL": "https://api.openphone.com",
    "QUO_FROM_NUMBER": "+14192622371",
    "AIRTABLE_BASE_ID": "appcAWPBQB8GmOrcT",
    "AIRTABLE_FAILED_PAYMENTS_TABLE_ID": "tbln6XXZzoubixUC8",
    "AIRTABLE_LEADS_TABLE_ID": "tblCrdvGKkGobRWxL",
    "META_GRAPH_API_VERSION": "v26.0",
    "META_AUTOMATION_ENABLED": "false",
    "META_TEST_MODE": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/10 * * * *", "0 * * * *", "5 * * * *", "15 * * * *", "35 * * * *"]
  }
}
