{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opwp-website",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ohiopetwastepros.com",
      "zone_name": "ohiopetwastepros.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ohiopetwastepros.com",
      "zone_name": "ohiopetwastepros.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opwp-backend",
      "database_id": "507e3ffd-5249-4ff1-a72f-463e37dc068e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FIELD_PROOFS",
      "bucket_name": "opwp-field-proofs"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "LEAD_PLAYBOOK_ENABLED": "true",
    "LEAD_PLAYBOOK_AUTO_SEND_ENABLED": "true",
    "LEAD_PLAYBOOK_NOTIFY_ENABLED": "true",
    "LEAD_PLAYBOOK_NOTIFY_CHANNELS": "sms",
    "LEAD_CONVERSATION_V2_ENABLED": "true",
    "LEAD_CLASSIFIER_ENABLED": "true",
    "LEAD_CLASSIFIER_PROVIDER": "workers_ai",
    "LEAD_CLASSIFIER_MODEL": "@cf/openai/gpt-oss-120b",
    "LEAD_CLASSIFIER_DAILY_CAP": "100",
    "LEAD_CLASSIFIER_TIMEOUT_MS": "12000",
    "LEAD_CLASSIFIER_KILL_SWITCH": "false",
    "LEAD_REPLY_WATCHDOG_ENABLED": "true",
    "LEAD_REPLY_WATCHDOG_SECONDS": "60",
    "LEAD_AUTOMATION_CONTROLLED_TEST_ONLY": "true",
    "META_CADENCE_ENABLED": "false",
    "FOOD_SALES_NATIVE_ENABLED": "true",
    "FOOD_SALES_RECORDING_ENABLED": "true",
    "FOOD_SALES_USE_PREVIOUS_COUNTS": "true",
    "FOOD_SALES_LEGACY_WRITES_FROZEN": "false",
    "FOOD_SALES_SNG_RECONCILIATION_ENABLED": "false",
    "DISPATCH_AUTOMATION_ENABLED": "false",
    "ROUTE_ROAD_CALCULATIONS_ENABLED": "false",
    "SITE_ORIGIN": "https://www.ohiopetwastepros.com",
    "WORKER_ORIGIN": "https://www.ohiopetwastepros.com",
    "TURNSTILE_HOSTNAMES": "ohiopetwastepros.com,www.ohiopetwastepros.com",
    "OWNER_NOTIFICATION_EMAIL": "Craig@ohiopetwastepros.com",
    "EMAIL_FROM": "Craig@ohiopetwastepros.com",
    "EMAIL_FROM_NAME": "Craig | Ohio Pet Waste Pros",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_SENDING_ENABLED": "true",
    "REVIEW_REQUESTS_ENABLED": "false",
    "RESEND_API_BASE_URL": "https://api.resend.com",
    "SMS_PROVIDER": "quo",
    "FIELD_NOTIFICATIONS_ENABLED": "false",
    "FIELD_SMS_DAILY_LIMIT": "100",
    "QUO_API_BASE_URL": "https://api.openphone.com",
    "QUO_FROM_NUMBER": "+14192622371",
    "AIRTABLE_BASE_ID": "appcAWPBQB8GmOrcT",
    "AIRTABLE_FAILED_PAYMENTS_TABLE_ID": "tbln6XXZzoubixUC8",
    "AIRTABLE_LEADS_TABLE_ID": "tblCrdvGKkGobRWxL",
    "META_GRAPH_API_VERSION": "v26.0",
    "META_ALLOWED_PAGE_IDS": "617929208074485",
    "META_AUTOMATION_ENABLED": "false",
    "META_AUTOMATION_APPROVAL_ID": "meta-live-2026-11-18",
    "META_TEST_MODE": "true",
    "META_TEST_APPROVAL_ID": "meta-test-conversation-2-2026-11-23-craig",
    "META_TEST_RECIPIENTS": "+14192620424",
    "META_TEST_FORM_IDS": "1725121795904553",
    "META_APPROVED_SMS_FORMS": "{\"1725121795904553\":{\"pageId\":\"617929208074485\",\"consentField\":\"text_message_consent\",\"disclosure\":\"Can we text you your quote? By choosing Yes, you agree Ohio Pet Waste Pros may send texts, including automated texts, about your quote and service to the number above. Consent isn't required to buy. Msg and data rates may apply. Reply STOP to opt out.\",\"version\":\"fb-consent-2026-11-18\"}}",
    "WINBACK_ENABLED": "false",
    "WINBACK_SEND_ENABLED": "false",
    "WINBACK_AUTOREPLY_ENABLED": "false",
    "WINBACK_KILL_SWITCH": "true",
    "WINBACK_STORAGE_READY": "false",
    "WINBACK_CAMPAIGN_ID": "",
    "WINBACK_SNG_PAUSED_PATH": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *", "0 * * * *", "5 * * * *", "15 * * * *", "35 * * * *"]
  }
}
