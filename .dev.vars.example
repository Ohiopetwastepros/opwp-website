# Copy to .dev.vars for local Cloudflare preview. Never commit .dev.vars.
# Use one Sweep & Go Open API token with every needed permission/event enabled.
SNG_API_KEY=""
SNG_WEBHOOK_SECRET=""
CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
CF_ACCESS_AUD=""
ADMIN_DEV_BYPASS="true"
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="use-a-strong-local-development-password"
ADMIN_SESSION_SECRET=""
ADMIN_MFA_ENCRYPTION_KEY=""
FIELD_AUTH_SECRET=""
PUBLIC_API_DEV_BYPASS="false"
APP_ENV="development"
ENVIRONMENT="development"
SITE_ORIGIN="http://localhost:3000"
WORKER_ORIGIN="http://localhost:8787"

# Public site key is safe for the browser; the secret is server-only. Use
# Cloudflare's documented test keys locally or create separate local/prod widgets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# Transactional owner/customer email. Store the real Resend key only as a
# Cloudflare secret. Delivery remains queued until the provider is configured.
EMAIL_PROVIDER="unconfigured"
EMAIL_SENDING_ENABLED="false"
RESEND_API_BASE_URL="https://api.resend.com"
RESEND_API_KEY=""
OWNER_NOTIFICATION_EMAIL="owner@example.com"
EMAIL_FROM="owner@example.com"
EMAIL_FROM_NAME="Owner | Ohio Pet Waste Pros"

# Stripe test keys first. Store live values with Wrangler secrets, never here.
STRIPE_SECRET_KEY=""
DOG_FOOD_TEST_CHECKOUT="false"
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_AIRTABLE_OPS_URL="https://airtable.com/appcAWPBQB8GmOrcT/tblhi8MGUOsWNmd37/viw5yCUbwl2GWnXff?blocks=hide"
AIRTABLE_BASE_ID="appcAWPBQB8GmOrcT"
AIRTABLE_OPERATIONS_TABLE_ID="tblhi8MGUOsWNmd37"
AIRTABLE_API_KEY=""
GEOAPIFY_API_KEY=""

# Google Business Profile review sync. Create OAuth credentials in the
# opwp-review-sync-503019 project and authorize the business.manage scope.
# Store all real values as Cloudflare secrets, including the location resource.
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REFRESH_TOKEN=""
GOOGLE_BUSINESS_LOCATION="accounts/ACCOUNT_ID/locations/LOCATION_ID"

# Browser key restricted to approved OPWP website referrers and only the
# Maps JavaScript API plus Geocoding API. Never commit the real key.
GOOGLE_MAPS_BROWSER_KEY=""

# QuickBooks Online production OAuth. Store real values with Wrangler secrets.
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="https://www.ohiopetwastepros.com/api/quickbooks/callback"
# Generate 32 random bytes and base64 encode them. Never rotate after connecting
# unless the QuickBooks connection is re-authorized.
QB_TOKEN_ENCRYPTION_KEY=""
QB_ENVIRONMENT="sandbox"
QB_CALLBACK_ORIGIN="http://localhost:3000"

# Quo uses its API key directly in the Authorization header (not Bearer).
# Store the production key with `wrangler secret put QUO_API_KEY`.
SMS_PROVIDER="unconfigured"
QUO_API_BASE_URL="https://api.openphone.com"
QUO_API_KEY=""
QUO_FROM_NUMBER="+14192622371"

# Non-secret Sweep & Go hosted-form identifiers used only to create a partial
# quote lead after the 10-minute abandonment delay.
SNG_PUBLIC_API_BASE_URL="https://api.sweepandgo.com"
SNG_ORGANIZATION_SLUG="ohio-pet-waste-pros-qkr3c"
SNG_ORGANIZATION_FORM_ID="7063"

# Optional local smoke-test targets. These are not production secrets.
SMOKE_BASE_URL="http://127.0.0.1:3000"
DOG_FOOD_SMOKE_BASE="http://127.0.0.1:3000"
DOG_FOOD_ADMIN_SMOKE_BASE="http://127.0.0.1:3000"
FIELD_SMOKE_BASE="http://127.0.0.1:3000"
FIELD_SMOKE_DATE=""
STRIPE_SMOKE_WEBHOOK_SECRET=""

# DB is a D1 binding and FIELD_PROOFS is an R2 binding declared in
# wrangler.jsonc; neither is a text environment variable.

# Shared only with Personal Financial OS. Generate a long random value and
# store it as a Wrangler secret in production; never put the real value here.
FINANCIAL_OS_SYNC_TOKEN=""

# Warren can be connected when its API base URL, authentication scheme, and
# endpoint documentation are available.
WARREN_API_URL=""
WARREN_API_TOKEN=""

# Meta automation stays off until a consent-enabled form and end-to-end test are approved.
META_AUTOMATION_ENABLED="false"
META_ALLOWED_PAGE_IDS=""
META_AUTOMATION_APPROVAL_ID=""
META_CADENCE_APPROVAL_ID=""
# JSON keyed by form ID: {"FORM_ID":{"pageId":"PAGE_ID","consentField":"sms_consent","disclosure":"Exact approved disclosure","version":"reviewed-v1"}}
META_APPROVED_SMS_FORMS="{}"
META_TEST_MODE="false"
META_TEST_APPROVAL_ID=""
META_TEST_RECIPIENTS=""
META_TEST_FORM_IDS=""

# Unified field notices: disabled until verified sender/preferences and dedicated
# API-generated Quo webhook are configured. API SMS uses metered credits.
FIELD_NOTIFICATIONS_ENABLED="false"
FIELD_SMS_DAILY_LIMIT="100"
FIELD_QUO_WEBHOOK_SIGNING_KEY=""
# Native food-sales pilot is disabled until the proposed schema, pricing and grants are approved.
FOOD_SALES_NATIVE_ENABLED=false
# Enable new native sales only after inventory verification; also freezes legacy new-sale entry.
FOOD_SALES_RECORDING_ENABLED=false
# Keep true after pilot activation if native writers are later paused.
FOOD_SALES_LEGACY_WRITES_FROZEN=false
# Separate review of actual SNG evidence is required before replacing legacy reconciliation.
FOOD_SALES_SNG_RECONCILIATION_ENABLED=false
