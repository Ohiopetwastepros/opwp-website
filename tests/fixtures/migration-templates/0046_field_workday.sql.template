ALTER TABLE route_partner_field_shifts ADD COLUMN revision INTEGER NOT NULL DEFAULT 0;
ALTER TABLE route_partner_field_shifts ADD COLUMN vehicle_type TEXT CHECK (vehicle_type IN ('personal','company'));
ALTER TABLE route_partner_field_shifts ADD COLUMN clock_in_notes TEXT;
ALTER TABLE route_partner_tasks ADD COLUMN started_at TEXT;
ALTER TABLE route_partner_tasks ADD COLUMN office_notes TEXT;
ALTER TABLE route_partner_field_breaks ADD COLUMN starting_mileage REAL;
ALTER TABLE route_partner_field_breaks ADD COLUMN ending_mileage REAL;
ALTER TABLE route_partner_shift_inventory ADD COLUMN missing_quantity INTEGER NOT NULL DEFAULT 0;


CREATE TRIGGER field_single_clock_in BEFORE UPDATE OF checked_in_at ON route_partner_field_shifts WHEN OLD.checked_in_at IS NULL AND NEW.checked_in_at IS NOT NULL BEGIN SELECT RAISE(ABORT,'FIELD_OTHER_SHIFT_OPEN') WHERE EXISTS (SELECT 1 FROM route_partner_field_shifts WHERE technician_member_id=NEW.technician_member_id AND id<>NEW.id AND checked_in_at IS NOT NULL AND completed_at IS NULL AND status<>'cancelled'); END;

CREATE TABLE route_partner_field_commands (
  id TEXT PRIMARY KEY,
  shift_id TEXT NOT NULL REFERENCES route_partner_field_shifts(id),
  member_id TEXT NOT NULL REFERENCES route_partner_members(id),
  expected_revision INTEGER NOT NULL,
  body_hash TEXT NOT NULL,
  result TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);


CREATE TRIGGER field_command_revision BEFORE INSERT ON route_partner_field_commands BEGIN SELECT RAISE(ABORT,'FIELD_REVISION_CONFLICT') WHERE NOT EXISTS (SELECT 1 FROM route_partner_field_shifts WHERE id=NEW.shift_id AND technician_member_id=NEW.member_id AND revision=NEW.expected_revision); UPDATE route_partner_field_shifts SET revision=revision+1 WHERE id=NEW.shift_id; END;

CREATE TABLE route_partner_field_closeouts (
  id TEXT PRIMARY KEY,
  organization_id TEXT NOT NULL REFERENCES route_partner_organizations(id),
  shift_id TEXT NOT NULL UNIQUE REFERENCES route_partner_field_shifts(id),
  status TEXT NOT NULL DEFAULT 'blocked' CHECK (status IN ('blocked','ready','sending','verification_required','verified')),
  reason TEXT NOT NULL,
  manifest TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  verified_at TEXT
);
CREATE INDEX idx_field_closeouts_org ON route_partner_field_closeouts(organization_id,created_at);
