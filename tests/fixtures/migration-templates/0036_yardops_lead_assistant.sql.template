INSERT OR IGNORE INTO lead_conversations
  (id,submission_id,organization_id,channel,status,automation_mode)
SELECT lower(hex(randomblob(4))) || '-' || lower(hex(randomblob(2))) || '-4' || substr(lower(hex(randomblob(2))),2) || '-a' || substr(lower(hex(randomblob(2))),2) || '-' || lower(hex(randomblob(6))),
       id,'org-opwp','website','open','suggest'
FROM submissions
WHERE kind IN ('partial_quote','question','waitlist','onboarding');

INSERT OR IGNORE INTO lead_airtable_sync (submission_id,organization_id,status)
