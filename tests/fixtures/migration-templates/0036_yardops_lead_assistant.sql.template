CREATE TABLE IF NOT EXISTS lead_conversations (
  id TEXT PRIMARY KEY,
  submission_id TEXT NOT NULL UNIQUE REFERENCES submissions(id) ON DELETE CASCADE,
  organization_id TEXT NOT NULL,
  channel TEXT NOT NULL DEFAULT 'website'
    CHECK (channel IN ('website','quo_sms','facebook_lead','messenger','manual')),
  external_thread_id TEXT,
  status TEXT NOT NULL DEFAULT 'open'
    CHECK (status IN ('open','waiting','resolved','deleted')),
  automation_mode TEXT NOT NULL DEFAULT 'suggest'
    CHECK (automation_mode IN ('paused','suggest','approved')),
  unread_count INTEGER NOT NULL DEFAULT 0 CHECK (unread_count >= 0),
  last_inbound_at TEXT,
  last_outbound_at TEXT,
  deleted_at TEXT,
  deletion_reason TEXT,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_lead_conversations_queue
  ON lead_conversations(organization_id, status, last_inbound_at DESC, updated_at DESC);

CREATE TABLE IF NOT EXISTS lead_messages (
  id TEXT PRIMARY KEY,
  conversation_id TEXT NOT NULL REFERENCES lead_conversations(id) ON DELETE CASCADE,
  organization_id TEXT NOT NULL,
  direction TEXT NOT NULL CHECK (direction IN ('inbound','outbound','internal')),
  channel TEXT NOT NULL CHECK (channel IN ('website','quo_sms','facebook_lead','messenger','manual')),
  provider_message_id TEXT,
  body TEXT NOT NULL CHECK (length(body) BETWEEN 1 AND 4000),
  delivery_status TEXT NOT NULL DEFAULT 'recorded'
    CHECK (delivery_status IN ('recorded','queued','sending','sent','delivered','failed','cancelled')),
  automated INTEGER NOT NULL DEFAULT 0 CHECK (automated IN (0,1)),
  answer_key TEXT,
  created_by TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_lead_messages_provider
  ON lead_messages(channel, provider_message_id) WHERE provider_message_id IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_lead_messages_timeline
  ON lead_messages(organization_id, conversation_id, created_at);

CREATE TABLE IF NOT EXISTS lead_answer_library (
  answer_key TEXT PRIMARY KEY,
  organization_id TEXT NOT NULL,
  category TEXT NOT NULL,
  question TEXT NOT NULL,
  answer_template TEXT NOT NULL,
  keywords TEXT NOT NULL DEFAULT '[]',
  response_mode TEXT NOT NULL DEFAULT 'static'
    CHECK (response_mode IN ('static','pricing','service_day','handoff')),
  approval_status TEXT NOT NULL DEFAULT 'approved'
    CHECK (approval_status IN ('draft','approved','retired')),
  auto_send_allowed INTEGER NOT NULL DEFAULT 0 CHECK (auto_send_allowed IN (0,1)),
  version INTEGER NOT NULL DEFAULT 1,
  updated_by TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_lead_answer_library_active
  ON lead_answer_library(organization_id, approval_status, category);

CREATE TABLE IF NOT EXISTS lead_automation_settings (
  organization_id TEXT PRIMARY KEY,
  assistant_enabled INTEGER NOT NULL DEFAULT 0 CHECK (assistant_enabled IN (0,1)),
  quiet_hours_enabled INTEGER NOT NULL DEFAULT 1 CHECK (quiet_hours_enabled IN (0,1)),
  quiet_hours_start TEXT NOT NULL DEFAULT '20:00',
  quiet_hours_end TEXT NOT NULL DEFAULT '08:00',
  time_zone TEXT NOT NULL DEFAULT 'America/New_York',
  max_follow_up_touches INTEGER NOT NULL DEFAULT 3 CHECK (max_follow_up_touches BETWEEN 0 AND 6),
  human_review_required INTEGER NOT NULL DEFAULT 1 CHECK (human_review_required IN (0,1)),
  updated_by TEXT NOT NULL,
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS lead_follow_up_jobs (
  id TEXT PRIMARY KEY,
  submission_id TEXT NOT NULL REFERENCES submissions(id) ON DELETE CASCADE,
  conversation_id TEXT NOT NULL REFERENCES lead_conversations(id) ON DELETE CASCADE,
  organization_id TEXT NOT NULL,
  sequence_step INTEGER NOT NULL CHECK (sequence_step BETWEEN 1 AND 6),
  due_at TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'queued'
    CHECK (status IN ('queued','sending','sent','cancelled','failed')),
  message_body TEXT NOT NULL CHECK (length(message_body) BETWEEN 1 AND 1000),
  attempt_count INTEGER NOT NULL DEFAULT 0 CHECK (attempt_count BETWEEN 0 AND 5),
  provider_message_id TEXT,
  error_message TEXT,
  sent_at TEXT,
  cancelled_at TEXT,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(conversation_id, sequence_step)
);

CREATE INDEX IF NOT EXISTS idx_lead_follow_up_due
  ON lead_follow_up_jobs(organization_id, status, due_at);

CREATE TABLE IF NOT EXISTS lead_airtable_sync (
  submission_id TEXT PRIMARY KEY REFERENCES submissions(id) ON DELETE CASCADE,
  organization_id TEXT NOT NULL,
  airtable_record_id TEXT,
  status TEXT NOT NULL DEFAULT 'queued'
    CHECK (status IN ('queued','syncing','synced','failed')),
  attempt_count INTEGER NOT NULL DEFAULT 0 CHECK (attempt_count BETWEEN 0 AND 10),
  next_attempt_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  payload_hash TEXT,
  error_message TEXT,
  synced_at TEXT,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_lead_airtable_due
  ON lead_airtable_sync(organization_id, status, next_attempt_at);

CREATE TABLE IF NOT EXISTS lead_suppressions (
  organization_id TEXT NOT NULL,
  phone_hash TEXT NOT NULL,
  reason TEXT NOT NULL,
  source TEXT NOT NULL,
  created_by TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY(organization_id, phone_hash)
);

CREATE TABLE IF NOT EXISTS lead_webhook_events (
  provider TEXT NOT NULL,
  event_id TEXT NOT NULL,
  organization_id TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'received'
    CHECK (status IN ('received','processed','ignored','failed')),
  error_message TEXT,
  received_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  processed_at TEXT,
  PRIMARY KEY(provider, event_id)
);

