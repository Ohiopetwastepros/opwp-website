CREATE TABLE IF NOT EXISTS routing_provider_cache (
  cache_key TEXT PRIMARY KEY,
  payload TEXT NOT NULL,
  expires_at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS routing_provider_cache_expiry ON routing_provider_cache(expires_at);
CREATE TABLE IF NOT EXISTS routing_provider_usage (
  usage_day TEXT PRIMARY KEY,
  credits INTEGER NOT NULL DEFAULT 0,
  blocked_until INTEGER NOT NULL DEFAULT 0
);
