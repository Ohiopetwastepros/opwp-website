CREATE TABLE field_demo_sessions (
  id TEXT PRIMARY KEY, token_hash TEXT NOT NULL UNIQUE, state_json TEXT NOT NULL,
  revision INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL
);
CREATE INDEX field_demo_expiry ON field_demo_sessions(expires_at);
CREATE TABLE field_demo_events (
  session_id TEXT NOT NULL REFERENCES field_demo_sessions(id) ON DELETE CASCADE,
  id TEXT NOT NULL, sequence INTEGER NOT NULL, body_hash TEXT NOT NULL,
  event_json TEXT NOT NULL, result_json TEXT NOT NULL, received_at INTEGER NOT NULL,
  PRIMARY KEY(session_id,id), UNIQUE(session_id,sequence)
);
CREATE TRIGGER field_demo_event_revision BEFORE INSERT ON field_demo_events BEGIN SELECT RAISE(ABORT,'DEMO_REVISION_CONFLICT') WHERE NOT EXISTS(SELECT 1 FROM field_demo_sessions WHERE id=NEW.session_id AND revision=NEW.sequence-1); END;
CREATE TRIGGER field_demo_event_commit AFTER INSERT ON field_demo_events BEGIN UPDATE field_demo_sessions SET revision=NEW.sequence,state_json=NEW.result_json WHERE id=NEW.session_id; END;
CREATE TABLE field_demo_photos (
  session_id TEXT NOT NULL REFERENCES field_demo_sessions(id) ON DELETE CASCADE,
  id TEXT NOT NULL, task_id TEXT NOT NULL, content_hash TEXT NOT NULL, body BLOB NOT NULL,
  PRIMARY KEY(session_id,id)
);
CREATE TRIGGER field_demo_photo_cap BEFORE INSERT ON field_demo_photos BEGIN SELECT RAISE(ABORT,'DEMO_PHOTO_LIMIT') WHERE (SELECT COUNT(*) FROM field_demo_photos WHERE session_id=NEW.session_id)>=12; END;
