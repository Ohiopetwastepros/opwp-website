CREATE TRIGGER food_on_way_email AFTER UPDATE OF status ON dog_food_deliveries WHEN NEW.status='out_for_delivery' AND OLD.status<>'out_for_delivery' BEGIN
  INSERT OR IGNORE INTO dog_food_transactional_outbox(event_key,customer_id,order_id,template)
    VALUES ('on_way:'||NEW.id,NEW.customer_id,NEW.order_id,'on_the_way');
END;
CREATE TRIGGER food_terminal_order AFTER UPDATE OF status ON dog_food_orders WHEN NEW.status IN ('cancelled','refunded') AND OLD.status<>NEW.status BEGIN
  UPDATE dog_food_capacity_allocations SET released_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND released_at IS NULL;
  UPDATE dog_food_lot_allocations SET released_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND consumed_at IS NULL AND released_at IS NULL;
  UPDATE dog_food_deliveries SET status='cancelled',updated_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND status<>'delivered';
  UPDATE route_partner_tasks SET status='cancelled',updated_at=CURRENT_TIMESTAMP WHERE dog_food_delivery_id IN
    (SELECT id FROM dog_food_deliveries WHERE order_id=NEW.id AND status='cancelled') AND status NOT IN ('completed','cancelled');
  INSERT OR IGNORE INTO dog_food_transactional_outbox(event_key,customer_id,order_id,template)
    VALUES (NEW.status||':'||NEW.id,NEW.customer_id,NEW.id,NEW.status);
END;
CREATE TRIGGER food_deleted_order AFTER UPDATE OF deleted_at ON dog_food_orders WHEN NEW.deleted_at IS NOT NULL AND OLD.deleted_at IS NULL BEGIN
  UPDATE dog_food_capacity_allocations SET released_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND released_at IS NULL;
  UPDATE dog_food_lot_allocations SET released_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND consumed_at IS NULL AND released_at IS NULL;
  UPDATE dog_food_deliveries SET status='cancelled',updated_at=CURRENT_TIMESTAMP WHERE order_id=NEW.id AND status<>'delivered';
  UPDATE route_partner_tasks SET status='cancelled',updated_at=CURRENT_TIMESTAMP WHERE dog_food_delivery_id IN
    (SELECT id FROM dog_food_deliveries WHERE order_id=NEW.id AND status='cancelled') AND status NOT IN ('completed','cancelled');
  UPDATE dog_food_transactional_outbox SET status='cancelled' WHERE order_id=NEW.id AND status IN ('queued','failed');
END;
CREATE TRIGGER food_deleted_customer AFTER UPDATE OF deleted_at ON dog_food_customers WHEN NEW.deleted_at IS NOT NULL AND OLD.deleted_at IS NULL BEGIN
  UPDATE dog_food_orders SET deleted_at=NEW.deleted_at,automation_review='Customer archived; paid funds retained for office reconciliation' WHERE customer_id=NEW.id AND deleted_at IS NULL;
  UPDATE dog_food_subscriptions SET status='paused',updated_at=CURRENT_TIMESTAMP WHERE customer_id=NEW.id AND status='active';
END;

CREATE TRIGGER sync_dog_food_customers_insert AFTER INSERT ON dog_food_customers BEGIN
  INSERT INTO dog_food_sync_outbox(entity_key,kind,entity_id) VALUES ('customer:'||NEW.id,'customer',NEW.id)
    ON CONFLICT(entity_key) DO UPDATE SET revision=revision+1,attempts=0,next_attempt_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP;
END;
