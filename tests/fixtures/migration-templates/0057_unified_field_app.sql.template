CREATE TABLE field_service_catalog (
  organization_id TEXT NOT NULL REFERENCES route_partner_organizations(id),
  id TEXT NOT NULL,
  name TEXT NOT NULL,
  unit_label TEXT NOT NULL,
  minutes_per_unit REAL NOT NULL CHECK (minutes_per_unit>=0 AND minutes_per_unit<=240),
  timed INTEGER NOT NULL CHECK (timed IN (0,1)),
  entry_required INTEGER NOT NULL CHECK (entry_required IN (0,1)),
  proof_kind TEXT NOT NULL CHECK (proof_kind IN ('gate','service','delivery','none')),
  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0,1)),
  instructions TEXT NOT NULL DEFAULT '',
  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY(organization_id,id)
);

