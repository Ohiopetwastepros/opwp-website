CREATE TABLE dog_food_ops_snapshots (
  id TEXT PRIMARY KEY, payload TEXT NOT NULL, captured_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE dog_food_ops_state (
  id TEXT PRIMARY KEY CHECK(id='org-opwp'), snapshot_id TEXT REFERENCES dog_food_ops_snapshots(id),
  dirty INTEGER NOT NULL DEFAULT 1, lease_token TEXT, lease_until TEXT, command_token TEXT, command_until TEXT,
  last_attempt_at TEXT, last_success_at TEXT, last_error TEXT,
  webhook_id TEXT, webhook_mac TEXT, webhook_expires_at TEXT, webhook_refreshed_at TEXT,
  alerts_enabled INTEGER NOT NULL DEFAULT 0, alert_hour INTEGER NOT NULL DEFAULT 9,
  default_recipient TEXT, last_alert_date TEXT
);
INSERT INTO dog_food_ops_state(id) VALUES ('org-opwp');
CREATE TABLE dog_food_ops_commands (
  id TEXT PRIMARY KEY, actor TEXT NOT NULL, action TEXT NOT NULL, payload_hash TEXT NOT NULL,
  status TEXT NOT NULL CHECK(status IN ('running','complete','failed')), result TEXT, error TEXT,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE dog_food_ops_audit (
  id TEXT PRIMARY KEY, actor TEXT NOT NULL, action TEXT NOT NULL, entity_id TEXT,
  details TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE dog_food_ops_alerts (
  id TEXT PRIMARY KEY, recipient TEXT NOT NULL, alert_date TEXT NOT NULL, content TEXT NOT NULL,
  status TEXT NOT NULL CHECK(status IN ('queued','sending','sent','failed','cancelled')),
  provider_id TEXT, error TEXT, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, sent_at TEXT,
  UNIQUE(recipient,alert_date)
);
CREATE TABLE dog_food_deleted_records (
  id TEXT PRIMARY KEY, entity_type TEXT NOT NULL, entity_id TEXT NOT NULL, label TEXT NOT NULL,
  payload TEXT NOT NULL, deleted_by TEXT NOT NULL, deleted_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  restored_at TEXT, UNIQUE(entity_type,entity_id)
);
ALTER TABLE dog_food_customers ADD COLUMN deleted_at TEXT;
ALTER TABLE dog_food_orders ADD COLUMN deleted_at TEXT;
CREATE INDEX idx_dog_food_ops_audit_date ON dog_food_ops_audit(created_at);
CREATE TABLE dog_food_api_budget (
  usage_day TEXT PRIMARY KEY, requests INTEGER NOT NULL DEFAULT 0, next_request_ms INTEGER NOT NULL DEFAULT 0
);
